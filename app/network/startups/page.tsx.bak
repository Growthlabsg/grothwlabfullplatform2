export default function StartupDirectoryPage() {
  const { toast } = useToast()
  const [searchQuery, setSearchQuery] = useState("")
  const [selectedIndustries, setSelectedIndustries] = useState<string[]>([])
  const [selectedStages, setSelectedStages] = useState<string[]>([])
  const [selectedSizes, setSelectedSizes] = useState<string[]>([])
  const [showVerifiedOnly, setShowVerifiedOnly] = useState(false)
  const [showHiringOnly, setShowHiringOnly] = useState(false)
  const [showPartnershipsOnly, setShowPartnershipsOnly] = useState(false)
  const [sortBy, setSortBy] = useState("recent")
  const [viewMode, setViewMode] = useState<"grid" | "list">("list")
  const [savedStartups, setSavedStartups] = useState<string[]>([])
  const [activeTab, setActiveTab] = useState("all")
  const [showAdvancedFilters, setShowAdvancedFilters] = useState(false)
  const [selectedTechnologies, setSelectedTechnologies] = useState<string[]>([])
  const [selectedLocations, setSelectedLocations] = useState<string[]>([])
  const [showRemoteOnly, setShowRemoteOnly] = useState(false)
  const [showVisaSponsorship, setShowVisaSponsorship] = useState(false)

  // Filter and search logic
  const filteredStartups = useMemo(() => {
    let filtered = STARTUPS.filter((startup) => {
      // Search query
      const matchesSearch = searchQuery === "" || 
        startup.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        startup.description.toLowerCase().includes(searchQuery.toLowerCase()) ||
        startup.industry.toLowerCase().includes(searchQuery.toLowerCase()) ||
        startup.tags.some(tag => tag.toLowerCase().includes(searchQuery.toLowerCase()))

      // Industry filter
      const matchesIndustry = selectedIndustries.length === 0 || 
        selectedIndustries.includes(startup.industry)

      // Stage filter
      const matchesStage = selectedStages.length === 0 || 
        selectedStages.includes(startup.stage)

      // Size filter
      const matchesSize = selectedSizes.length === 0 || 
        selectedSizes.includes(startup.employees)

      // Verification filter
      const matchesVerification = !showVerifiedOnly || startup.verified

      // Hiring filter
      const matchesHiring = !showHiringOnly || startup.hiring

      // Partnerships filter
      const matchesPartnerships = !showPartnershipsOnly || startup.partnerships

      // Tab filter
      let matchesTab = true
      if (activeTab === "featured") {
        matchesTab = startup.featured
      } else if (activeTab === "hiring") {
        matchesTab = startup.hiring
      } else if (activeTab === "recent") {
        matchesTab = startup.founded === "2021" || startup.founded === "2020"
      }

      return matchesSearch && matchesIndustry && matchesStage && matchesSize && 
             matchesVerification && matchesHiring && matchesPartnerships && matchesTab
    })

    // Sorting
    switch (sortBy) {
      case "name":
        filtered.sort((a, b) => a.name.localeCompare(b.name))
        break
      case "funding":
        filtered.sort((a, b) => {
          const aFunding = parseFloat(a.funding.replace(/[^0-9.]/g, ""))
          const bFunding = parseFloat(b.funding.replace(/[^0-9.]/g, ""))
          return bFunding - aFunding
        })
        break
      case "views":
        filtered.sort((a, b) => b.views - a.views)
        break
      case "growth":
        filtered.sort((a, b) => {
          const aGrowth = parseFloat(a.growthRate.replace(/[^0-9.]/g, ""))
          const bGrowth = parseFloat(b.growthRate.replace(/[^0-9.]/g, ""))
          return bGrowth - aGrowth
        })
        break
      case "recent":
      default:
        filtered.sort((a, b) => parseInt(b.founded) - parseInt(a.founded))
        break
    }

    return filtered
  }, [searchQuery, selectedIndustries, selectedStages, selectedSizes, showVerifiedOnly, 
      showHiringOnly, showPartnershipsOnly, sortBy, activeTab])

  const handleIndustryToggle = (industry: string) => {
    setSelectedIndustries(prev => 
      prev.includes(industry) 
        ? prev.filter(i => i !== industry)
        : [...prev, industry]
    )
  }

  const handleStageToggle = (stage: string) => {
    setSelectedStages(prev => 
      prev.includes(stage) 
        ? prev.filter(s => s !== stage)
        : [...prev, stage]
    )
  }

  const handleSizeToggle = (size: string) => {
    setSelectedSizes(prev => 
      prev.includes(size) 
        ? prev.filter(s => s !== size)
        : [...prev, size]
    )
  }

  const handleSaveStartup = (startupId: string) => {
    setSavedStartups(prev => {
      const newSaved = prev.includes(startupId) 
        ? prev.filter(id => id !== startupId)
        : [...prev, startupId]
      
      toast({
        title: prev.includes(startupId) ? "Removed from saved" : "Added to saved",
        description: prev.includes(startupId) 
          ? "Startup removed from your saved list" 
          : "Startup added to your saved list",
      })
      
      return newSaved
    })
  }

  const handleShareStartup = (startup: any) => {
    const shareText = `Check out ${startup.name} - ${startup.description}`
    const shareUrl = `${window.location.origin}/network/startups/${startup.id}`
    
    if (navigator.share) {
      navigator.share({
        title: startup.name,
        text: shareText,
        url: shareUrl,
      })
    } else {
      navigator.clipboard.writeText(`${shareText}\n${shareUrl}`)
      toast({
        title: "Link copied",
        description: "Startup link copied to clipboard",
      })
    }
  }

  const handleContactStartup = (startup: any) => {
    toast({
      title: "Contact initiated",
      description: `Opening contact form for ${startup.name}`,
    })
  }

  const clearAllFilters = () => {
    setSearchQuery("")
    setSelectedIndustries([])
    setSelectedStages([])
    setSelectedSizes([])
    setShowVerifiedOnly(false)
    setShowHiringOnly(false)
    setShowPartnershipsOnly(false)
    setSortBy("recent")
    setActiveTab("all")
  }

  const hasActiveFilters = searchQuery || selectedIndustries.length > 0 || selectedStages.length > 0 || 
                         selectedSizes.length > 0 || showVerifiedOnly || showHiringOnly || showPartnershipsOnly

  return (
    <div className="container mx-auto max-w-7xl px-4 py-12">
        <div className="mb-8">
          <div className="flex items-center justify-between mb-4">
            <div>
              <h1 className="text-3xl font-bold mb-2">Startup Directory</h1>
              <p className="text-[#334155] max-w-3xl">
                Discover innovative startups across Singapore and connect with founders, investors, and industry experts.
                Filter by industry, funding stage, and more to find the perfect match for your interests.
              </p>
            </div>
            <div className="flex items-center gap-2">
              <Button variant="outline" size="sm" onClick={clearAllFilters} disabled={!hasActiveFilters}>
                Clear Filters
              </Button>
              <Button variant="outline" size="sm">
                <Download className="h-4 w-4 mr-2" />
                Export
              </Button>
            </div>
          </div>
          
          {/* Quick Stats */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <Card>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm text-[#334155]">Total Startups</p>
                    <p className="text-2xl font-bold">{STARTUPS.length}</p>
                  </div>
                  <Rocket className="h-8 w-8 text-[#0F7377]" />
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm text-[#334155]">Hiring Now</p>
                    <p className="text-2xl font-bold">{STARTUPS.filter(s => s.hiring).length}</p>
                  </div>
                  <Target className="h-8 w-8 text-green-600" />
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm text-[#334155]">Verified</p>
                    <p className="text-2xl font-bold">{STARTUPS.filter(s => s.verified).length}</p>
                  </div>
                  <Award className="h-8 w-8 text-blue-600" />
                </div>
              </CardContent>
            </Card>
            <Card>
              <CardContent className="p-4">
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-sm text-[#334155]">Open Positions</p>
                    <p className="text-2xl font-bold">{STARTUPS.reduce((sum, s) => sum + s.openPositions, 0)}</p>
                  </div>
                  <Users className="h-8 w-8 text-purple-600" />
                </div>
              </CardContent>
            </Card>
          </div>
        </div>

        <div className="grid md:grid-cols-4 gap-8">
          <div className="md:col-span-1">
            <div className="sticky top-24 space-y-6">
              <Card>
                <CardContent className="p-4">
                  <div className="flex items-center justify-between mb-4">
                    <h3 className="font-medium">Filters</h3>
                    {hasActiveFilters && (
                      <Badge variant="secondary" className="text-xs">
                        {filteredStartups.length} results
                      </Badge>
                    )}
                  </div>
                  <div className="space-y-4">
                    <div>
                      <label className="text-sm font-medium mb-2 block">Industry</label>
                      <div className="space-y-2">
                        {["Artificial Intelligence", "Financial Technology", "Healthcare Technology", "Education Technology", "Logistics & Transportation", "Agricultural Technology"].map((industry) => (
                          <div key={industry} className="flex items-center space-x-2">
                            <Checkbox
                              id={industry}
                              checked={selectedIndustries.includes(industry)}
                              onCheckedChange={() => handleIndustryToggle(industry)}
                            />
                            <label htmlFor={industry} className="text-sm">
                              {industry}
                            </label>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div>
                      <label className="text-sm font-medium mb-2 block">Funding Stage</label>
                      <div className="space-y-2">
                        {["Pre-Seed", "Seed", "Series A", "Series B+"].map((stage) => (
                          <div key={stage} className="flex items-center space-x-2">
                            <Checkbox
                              id={stage}
                              checked={selectedStages.includes(stage)}
                              onCheckedChange={() => handleStageToggle(stage)}
                            />
                            <label htmlFor={stage} className="text-sm">
                              {stage}
                            </label>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div>
                      <label className="text-sm font-medium mb-2 block">Company Size</label>
                      <div className="space-y-2">
                        {["1-10", "10-25", "25-50", "50-100", "100+"].map((size) => (
                          <div key={size} className="flex items-center space-x-2">
                            <Checkbox
                              id={size}
                              checked={selectedSizes.includes(size)}
                              onCheckedChange={() => handleSizeToggle(size)}
                            />
                            <label htmlFor={size} className="text-sm">
                              {size} employees
                            </label>
                          </div>
                        ))}
                      </div>
                    </div>

                    <div>
                      <label className="text-sm font-medium mb-2 block">Quick Filters</label>
                      <div className="space-y-2">
                        <div className="flex items-center space-x-2">
                          <Checkbox
                            id="verified"
                            checked={showVerifiedOnly}
                            onCheckedChange={(checked) => setShowVerifiedOnly(checked as boolean)}
                          />
                          <label htmlFor="verified" className="text-sm">
                            Verified Startups Only
                          </label>
                        </div>
                        <div className="flex items-center space-x-2">
                          <Checkbox
                            id="hiring"
                            checked={showHiringOnly}
                            onCheckedChange={(checked) => setShowHiringOnly(checked as boolean)}
                          />
                          <label htmlFor="hiring" className="text-sm">
                            Hiring Now
                          </label>
                        </div>
                        <div className="flex items-center space-x-2">
                          <Checkbox
                            id="partnerships"
                            checked={showPartnershipsOnly}
                            onCheckedChange={(checked) => setShowPartnershipsOnly(checked as boolean)}
                          />
                          <label htmlFor="partnerships" className="text-sm">
                            Open to Partnerships
                          </label>
                        </div>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardContent className="p-4">
                  <h3 className="font-medium mb-4">Saved Startups</h3>
                  <p className="text-sm text-[#334155] mb-4">
                    {savedStartups.length === 0 
                      ? "You haven't saved any startups yet. Click the star icon to save startups for later."
                      : `You have ${savedStartups.length} saved startup${savedStartups.length > 1 ? 's' : ''}.`
                    }
                  </p>
                  <Button variant="outline" className="w-full" asChild>
                    <Link href="/network/saved-startups">View Saved Startups</Link>
                  </Button>
                </CardContent>
              </Card>
            </div>
          </div>

          <div className="md:col-span-3">
            <div className="mb-6">
              <div className="flex flex-col md:flex-row gap-4 mb-6">
                <div className="relative flex-grow">
                  <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                  <Input 
                    placeholder="Search startup name, industry, or keywords..." 
                    className="pl-9"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                  />
                </div>
                <div className="flex gap-2">
                  <Select value={sortBy} onValueChange={setSortBy}>
                    <SelectTrigger className="w-[140px]">
                      <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="recent">Most Recent</SelectItem>
                      <SelectItem value="name">Name A-Z</SelectItem>
                      <SelectItem value="funding">Highest Funding</SelectItem>
                      <SelectItem value="views">Most Viewed</SelectItem>
                      <SelectItem value="growth">Highest Growth</SelectItem>
                    </SelectContent>
                  </Select>
                  <Button 
                    variant="outline" 
                    size="icon"
                    onClick={() => setViewMode(viewMode === "grid" ? "list" : "grid")}
                  >
                    {viewMode === "grid" ? <List className="h-4 w-4" /> : <Grid3X3 className="h-4 w-4" />}
                  </Button>
                </div>
              </div>

              <Tabs value={activeTab} onValueChange={setActiveTab}>
                <TabsList>
                  <TabsTrigger value="all">All Startups ({STARTUPS.length})</TabsTrigger>
                  <TabsTrigger value="featured">Featured ({STARTUPS.filter(s => s.featured).length})</TabsTrigger>
                  <TabsTrigger value="recent">Recently Added ({STARTUPS.filter(s => s.founded === "2021" || s.founded === "2020").length})</TabsTrigger>
                  <TabsTrigger value="hiring">Hiring Now ({STARTUPS.filter(s => s.hiring).length})</TabsTrigger>
                </TabsList>
              </Tabs>
            </div>

            <div className="space-y-4">
              {/* Featured startup highlight */}
              {filteredStartups.filter(s => s.featured).slice(0, 1).map((startup) => (
                <Card key={startup.id} className="bg-gradient-to-r from-[#0F7377]/10 to-transparent border-[#0F7377]/20">
                  <CardContent className="p-6">
                    <div className="flex items-center gap-4 mb-4">
                      <Badge variant="outline" className="bg-[#0F7377]/10 text-[#0F7377] border-[#0F7377]/30">
                        Featured Startup
                      </Badge>
                      {startup.verified && (
                        <Badge variant="outline" className="bg-green-100 text-green-800 border-green-200">
                          Verified
                        </Badge>
                      )}
                      {startup.hiring && (
                        <Badge variant="outline" className="bg-blue-100 text-blue-800 border-blue-200">
                          <Target className="h-3 w-3 mr-1" />
                          Hiring
                        </Badge>
                      )}
                    </div>
                    <div className="flex flex-col md:flex-row gap-6">
                      <div className="flex-shrink-0">
                        <div className="h-24 w-24 relative rounded-lg overflow-hidden border border-gray-200 bg-white">
                          <Image src={startup.logo} alt={startup.name} fill className="object-contain p-2" />
                        </div>
                      </div>
                      <div className="flex-1">
                        <div className="flex items-start justify-between">
                          <div>
                            <h3 className="text-xl font-bold">{startup.name}</h3>
                            <p className="text-[#334155]">{startup.description}</p>
                          </div>
                          <div className="flex gap-2">
                            <Button 
                              variant="ghost" 
                              size="icon" 
                              className="h-8 w-8"
                              onClick={() => handleSaveStartup(startup.id)}
                            >
                              <Star className={`h-4 w-4 ${savedStartups.includes(startup.id) ? 'fill-yellow-400 text-yellow-400' : ''}`} />
                            </Button>
                            <Button 
                              variant="ghost" 
                              size="icon" 
                              className="h-8 w-8"
                              onClick={() => handleShareStartup(startup)}
                            >
                              <Share2 className="h-4 w-4" />
                            </Button>
                          </div>
                        </div>
                        <div className="flex flex-wrap gap-3 mt-3">
                          <div className="flex items-center text-sm text-[#334155]">
                            <Briefcase className="h-4 w-4 mr-1" />
                            {startup.industry}
                          </div>
                          <div className="flex items-center text-sm text-[#334155]">
                            <MapPin className="h-4 w-4 mr-1" />
                            {startup.location}
                          </div>
                          <div className="flex items-center text-sm text-[#334155]">
                            <Calendar className="h-4 w-4 mr-1" />
                            Founded {startup.founded}
                          </div>
                          <div className="flex items-center text-sm text-[#334155]">
                            <TrendingUp className="h-4 w-4 mr-1" />
                            {startup.funding} Funding
                          </div>
                          <div className="flex items-center text-sm text-[#334155]">
                            <Users className="h-4 w-4 mr-1" />
                            {startup.employees} employees
                          </div>
                          <div className="flex items-center text-sm text-[#334155]">
                            <Eye className="h-4 w-4 mr-1" />
                            {startup.views} views
                          </div>
                        </div>
                        <div className="flex flex-wrap gap-2 mt-4">
                          {startup.tags.map((tag) => (
                            <Badge key={tag} variant="secondary" className="text-xs">
                              {tag}
                            </Badge>
                          ))}
                        </div>
                        <div className="flex justify-between items-center mt-4">
                          <div className="flex items-center gap-2">
                            {startup.hiring && (
                              <Badge variant="outline" className="bg-blue-50 text-blue-700 border-blue-100">
                                <Target className="h-3 w-3 mr-1" />
                                {startup.openPositions} Open Positions
                              </Badge>
                            )}
                            {startup.partnerships && (
                              <Badge variant="outline" className="bg-purple-50 text-purple-700 border-purple-100">
                                <Globe className="h-3 w-3 mr-1" />
                                Open to Partnerships
                              </Badge>
                            )}
                            {startup.visaSponsorship && (
                              <Badge variant="outline" className="bg-green-50 text-green-700 border-green-100">
                                <Globe className="h-3 w-3 mr-1" />
                                Visa Sponsorship
                              </Badge>
                            )}
                          </div>
                          <div className="flex gap-2">
                            <Button 
                              size="sm" 
                              variant="outline"
                              onClick={() => handleContactStartup(startup)}
                            >
                              <Mail className="h-3 w-3 mr-1" />
                              Contact
                            </Button>
                            <Button size="sm" className="bg-[#0F7377] hover:bg-[#0F7377]/90" asChild>
                              <Link href={`/network/startups/${startup.id}`}>
                                View Profile
                                <ArrowUpRight className="ml-1 h-3 w-3" />
                              </Link>
                            </Button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}

              {/* Startup listings */}
              {filteredStartups.filter(s => !s.featured || s.id !== "3").map((startup) => (
                <Card key={startup.id} className="transition-all hover:shadow-md">
                  <CardContent className="p-6">
                    <div className="flex flex-col md:flex-row gap-6">
                      <div className="flex-shrink-0">
                        <div className="h-16 w-16 relative rounded-lg overflow-hidden border border-gray-200 bg-white">
                          <Image
                            src={startup.logo}
                            alt={startup.name}
                            fill
                            className="object-contain p-2"
                          />
                        </div>
                      </div>
                      <div className="flex-1">
                        <div className="flex items-start justify-between">
                          <div className="flex items-center gap-2">
                            <h4 className="font-medium">{startup.name}</h4>
                            {startup.verified && (
                              <Badge
                                variant="outline"
                                className="bg-green-50 text-green-700 border-green-100 text-xs"
                              >
                                Verified
                              </Badge>
                            )}
                            {startup.hiring && (
                              <Badge
                                variant="outline"
                                className="bg-blue-50 text-blue-700 border-blue-100 text-xs"
                              >
                                Hiring
                              </Badge>
                            )}
                          </div>
                          <div className="flex gap-2">
                            <Button 
                              variant="ghost" 
                              size="icon" 
                              className="h-8 w-8"
                              onClick={() => handleSaveStartup(startup.id)}
                            >
                              <Star className={`h-4 w-4 ${savedStartups.includes(startup.id) ? 'fill-yellow-400 text-yellow-400' : ''}`} />
                            </Button>
                            <Button 
                              variant="ghost" 
                              size="icon" 
                              className="h-8 w-8"
                              onClick={() => handleShareStartup(startup)}
                            >
                              <Share2 className="h-4 w-4" />
                            </Button>
                          </div>
                        </div>
                        <p className="text-sm text-[#334155] mt-1">{startup.description}</p>
                        <div className="flex flex-wrap gap-2 mt-3">
                          <div className="flex items-center text-xs text-[#334155]">
                            <Briefcase className="h-3 w-3 mr-1" />
                            {startup.industry}
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <MapPin className="h-3 w-3 mr-1" />
                            {startup.location}
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <Calendar className="h-3 w-3 mr-1" />
                            Founded {startup.founded}
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <TrendingUp className="h-3 w-3 mr-1" />
                            {startup.funding} Funding
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <Users className="h-3 w-3 mr-1" />
                            {startup.employees} employees
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <Eye className="h-3 w-3 mr-1" />
                            {startup.views} views
                          </div>
                          <div className="flex items-center text-xs text-[#334155]">
                            <Lightbulb className="h-3 w-3 mr-1" />
                            {startup.growthRate} growth
                          </div>
                        </div>
                        <div className="flex flex-wrap gap-2 mt-3">
                          {startup.tags.map((tag) => (
                            <Badge key={tag} variant="outline" className="text-xs">
                              {tag}
                            </Badge>
                          ))}
                        </div>
                        <div className="flex justify-between items-center mt-4">
                          <div className="flex items-center gap-2">
                            {startup.hiring && (
                              <Badge variant="outline" className="bg-blue-50 text-blue-700 border-blue-100 text-xs">
                                <Target className="h-3 w-3 mr-1" />
                                {startup.openPositions} positions
                              </Badge>
                            )}
                            {startup.partnerships && (
                              <Badge variant="outline" className="bg-purple-50 text-purple-700 border-purple-100 text-xs">
                                <Globe className="h-3 w-3 mr-1" />
                                Partnerships
                              </Badge>
                            )}
                            {startup.visaSponsorship && (
                              <Badge variant="outline" className="bg-green-50 text-green-700 border-green-100 text-xs">
                                <Globe className="h-3 w-3 mr-1" />
                                Visa Sponsorship
                              </Badge>
                            )}
                          </div>
                          <div className="flex gap-2">
                            <Button 
                              size="sm" 
                              variant="outline"
                              onClick={() => handleContactStartup(startup)}
                            >
                              <Mail className="h-3 w-3 mr-1" />
                              Contact
                            </Button>
                            <Button size="sm" className="bg-[#0F7377] hover:bg-[#0F7377]/90" asChild>
                              <Link href={`/network/startups/${startup.id}`}>
                                View Profile
                                <ArrowUpRight className="ml-1 h-3 w-3" />
                              </Link>
                            </Button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              ))}

              {/* No results message */}
              {filteredStartups.length === 0 && (
                <Card>
                  <CardContent className="p-12 text-center">
                    <div className="mb-4">
                      <Search className="h-12 w-12 text-gray-400 mx-auto mb-4" />
                      <h3 className="text-lg font-medium mb-2">No startups found</h3>
                      <p className="text-[#334155] mb-4">
                        Try adjusting your search criteria or filters to find more startups.
                      </p>
                      <Button onClick={clearAllFilters} variant="outline">
                        Clear All Filters
                      </Button>
                    </div>
                  </CardContent>
                </Card>
              )}

              {/* View more button */}
              {filteredStartups.length > 0 && (
                <div className="flex justify-center mt-8">
                  <Button variant="outline" className="gap-2">
                    View More Startups
                    <ChevronRight className="h-4 w-4" />
                  </Button>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
