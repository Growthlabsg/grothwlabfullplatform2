"use client"

import React from "react"
import { useState } from "react"
import Link from "next/link"
import { usePathname } from "next/navigation"
import { Button } from "@/components/ui/button"
import { LanguageSelector } from "@/components/language/language-selector"
import { SubscriptionIndicator } from "@/components/subscription/subscription-indicator"
import { Menu, X, Bell } from "lucide-react"
import { useAuth } from "@/contexts/auth-context"
import { useNotifications } from "@/contexts/notification-context"
import Image from "next/image"
import { PersistentQRButton } from "@/components/qr-code/persistent-qr-button"
import { SimpleThemeToggle } from "@/components/theme-toggle"

interface HeaderProps {
  toggleSidebar: () => void
  isMobile: boolean
  isTablet: boolean
  isDesktop: boolean
}

export function Header({ toggleSidebar, isMobile, isTablet, isDesktop }: HeaderProps) {
  const { user } = useAuth()
  const { unreadCount } = useNotifications()
  const pathname = usePathname()
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false)
  const [searchOpen, setSearchOpen] = useState(false)

  const isActive = (path: string) => pathname === path
  
  // 🚀 Responsive navigation items
  const getNavigationItems = () => {
    const baseItems = [
      { href: "/about", label: "About" },
      { href: "/services", label: "Services" },
      { href: "/programmes", label: "Programmes" },
      { href: "/events", label: "Events" },
      { href: "/resources", label: "Resources" },
      { href: "/feed", label: "Feed" }
    ]
    
    if (isMobile) {
      return baseItems.slice(0, 3) // Show fewer items on mobile
    } else if (isTablet) {
      return baseItems.slice(0, 4) // Show some items on tablet
    }
    return baseItems // Show all items on desktop
  }

  return (
    <header className="sticky top-0 z-30 w-full border-b border-gray-200 dark:border-gray-700 bg-white/95 dark:bg-gray-900/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 dark:supports-[backdrop-filter]:bg-gray-900/80 shadow-sm">
      {/* 🚀 Enhanced Responsive Header Container */}
      <div className="container-responsive flex h-16 items-center justify-between">
        {/* 🚀 Enhanced Logo and Mobile Menu */}
        <div className="flex items-center gap-2 md:gap-3">
          {/* 🚀 Responsive Sidebar Toggle */}
          {(isMobile || isTablet) && (
            <Button 
              variant="ghost" 
              size="icon" 
              onClick={toggleSidebar} 
              className="sidebar-toggle md:hidden hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target"
            >
              <Menu className="h-5 w-5" />
              <span className="sr-only">Toggle sidebar</span>
            </Button>
          )}
          
          {/* 🚀 Responsive Logo */}
          <Link href="/" className="flex items-center gap-2 group">
            <Image 
              src="/images/GrowthLab Icon (1).png" 
              alt="GrowthLab" 
              width={isMobile ? 40 : isTablet ? 44 : 48}
              height={isMobile ? 40 : isTablet ? 44 : 48}
              className="flex-shrink-0" 
              priority
            />
            <span className={`font-semibold bg-gradient-to-r from-[#0F7377] to-[#1E293B] bg-clip-text text-transparent transition-all duration-300 ${
              isMobile ? 'text-base hidden' : isTablet ? 'text-lg' : 'text-lg'
            } ${isMobile ? '' : 'inline-block'}`}>
              GrowthLab
            </span>
          </Link>
        </div>

        {/* 🚀 Enhanced Responsive Navigation */}
        <nav className={`${isMobile ? 'hidden' : 'flex'} items-center gap-3 md:gap-4 lg:gap-6`}>
          {getNavigationItems().map((item) => (
            <Link
              key={item.href}
              href={item.href}
              className={`font-medium transition-all duration-200 hover:text-[#0F7377] focus-responsive ${
                isActive(item.href) 
                  ? "text-[#0F7377] font-semibold" 
                  : "text-gray-600 dark:text-gray-300"
              } ${
                isMobile ? 'text-xs' : isTablet ? 'text-sm' : 'text-sm'
              }`}
            >
              {item.label}
            </Link>
          ))}
          
          {/* 🚀 Responsive Search Toggle */}
          {isTablet && (
            <Button
              variant="ghost"
              size="icon"
              onClick={() => setSearchOpen(!searchOpen)}
              className="hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target"
            >
              <svg className="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </Button>
          )}
        </nav>

        {/* 🚀 Enhanced Mobile Menu Button */}
        {isMobile && (
          <Button 
            variant="ghost" 
            size="icon" 
            className="md:hidden hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target" 
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
          >
            {mobileMenuOpen ? <X className="h-5 w-5" /> : <Menu className="h-5 w-5" />}
            <span className="sr-only">Toggle mobile menu</span>
          </Button>
        )}

        {/* 🚀 Enhanced Mobile Menu */}
        {mobileMenuOpen && isMobile && (
          <div className="absolute top-16 left-0 right-0 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 p-4 md:hidden z-50 shadow-lg animate-responsive">
            <nav className="flex flex-col space-y-4">
              {/* 🚀 Responsive Mobile Navigation Items */}
              {getNavigationItems().map((item) => (
                <Link
                  key={item.href}
                  href={item.href}
                  className={`font-medium transition-all duration-200 hover:text-[#0F7377] focus-responsive ${
                    isActive(item.href) 
                      ? "text-[#0F7377] font-semibold" 
                      : "text-gray-600 dark:text-gray-300"
                  } text-base py-2 px-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800`}
                  onClick={() => setMobileMenuOpen(false)}
                >
                  {item.label}
                </Link>
              ))}
              
              {/* 🚀 Additional Mobile-Only Items */}
              <div className="border-t border-gray-200 dark:border-gray-700 pt-4 mt-4">
                <Link
                  href="/contact"
                  className={`font-medium transition-all duration-200 hover:text-[#0F7377] focus-responsive ${
                    isActive("/contact") 
                      ? "text-[#0F7377] font-semibold" 
                      : "text-gray-600 dark:text-gray-300"
                  } text-base py-2 px-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 block`}
                  onClick={() => setMobileMenuOpen(false)}
                >
                  Contact
                </Link>
              </div>
            </nav>
          </div>


        {/* 🚀 Enhanced Right Side Actions */}
        <div className="flex items-center gap-2 md:gap-4">
          {/* 🚀 Responsive Theme Toggle */}
          <SimpleThemeToggle />
          
          {/* 🚀 Responsive QR Button */}
          <PersistentQRButton 
            variant="ghost" 
            size="icon" 
            className="hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target" 
          />
          
          {/* 🚀 Responsive Language Selector */}
          <LanguageSelector />
          
          {/* 🚀 Responsive Subscription Indicator */}
          <SubscriptionIndicator />

          {/* 🚀 Enhanced Notification Bell */}
          <Button
            variant="ghost"
            size="icon"
            className="relative hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target"
            title="Notifications"
            asChild
          >
            <Link href="/notifications">
              <Bell className="h-5 w-5" />
              {unreadCount > 0 && (
                <div className="absolute -top-1 -right-1 h-4 w-4 bg-red-500 rounded-full flex items-center justify-center">
                  <span className="text-xs text-white font-medium">
                    {unreadCount > 99 ? "99+" : unreadCount}
                  </span>
                </div>
              )}
            </Link>
          </Button>

          {/* 🚀 Enhanced User Authentication */}
          {!user ? (
            <div className="flex items-center gap-2">
              <Button 
                variant="ghost" 
                size="sm" 
                asChild 
                className="hidden sm:flex hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200 touch-target"
              >
                <Link href="/login">Sign In</Link>
              </Button>
              <Button size="sm" className="bg-gradient-to-r from-[#0F7377] to-[#1E293B] text-white hover:from-[#0F7377]/90 hover:to-[#1E293B]/90 shadow-md hover:shadow-lg transition-all duration-200" asChild>
                <Link href="/accelerator/apply">Apply Now</Link>
              </Button>
            </div>
          ) : (
            <Button variant="ghost" size="sm" asChild className="hover:bg-gray-100 dark:hover:bg-gray-800 transition-all duration-200">
              <Link href="/dashboard">Dashboard</Link>
            </Button>
          )}
        </div>
      </div>
    </header>
  )
}
